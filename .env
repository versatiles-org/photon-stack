# Tag of ghcr.io/versatiles-org/photon to run: a Photon version, or
# `sha-<commit>` for an earlier build (see .github/workflows/image.yml).
PHOTON_VERSION=1.2.1

# Host directory holding photon_data/. MUST be on /dev/sda1 (local NVMe, 0.19ms
# seeks) and NOT on /mnt/photon-data (network volume, 1.08ms seeks). This is the
# single biggest performance decision in this stack.
PHOTON_DATA_DIR=/var/lib/photon

# Host port, bound to loopback only; nginx proxies to it.
# 2323 during migration so the old 0.6.2 service can keep serving on 2322.
PHOTON_HOST_PORT=2323

# uid:gid owning PHOTON_DATA_DIR on the host (existing `photon` user = 1000).
# The container runs as this user (`user:` in docker-compose.yml).
PHOTON_UID=1000
PHOTON_GID=1000

# Heap. Measured on the old instance: peak 1.9 GB used, 0 full GCs in 428 days,
# against a LARGER index. 4g is generous. Every GB here is a GB the kernel
# cannot use to cache the index, which is what actually determines latency.
JAVA_HEAP_MIN=2g
JAVA_HEAP_MAX=4g
