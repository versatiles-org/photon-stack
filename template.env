# Copy to .env and adjust: `cp template.env .env`. .env is not committed.

# The host name nginx serves and holds a certificate for.
DOMAIN_NAME=geocode.versatiles.org

# Tag of ghcr.io/versatiles-org/photon to run: a Photon version, or
# `sha-<commit>` for an earlier build (see .github/workflows/image.yml).
PHOTON_VERSION=1.3.0

# Host directory holding photon_data/. MUST be on the server's local NVMe disk
# (0.19 ms seeks), not on a network volume (1.08 ms seeks, measured on Hetzner).
# This is the single biggest performance decision in this stack.
PHOTON_DATA_DIR=/var/lib/photon

# The dump bin/index/update.sh installs. GraphHopper rebuilds it about weekly;
# the 1.0 format is the one Photon 1.x reads. A region instead of the planet:
# .../public/europe/andorra/photon-db-andorra-1.0-latest.tar.bz2, and so on.
PHOTON_DUMP_URL=https://download1.graphhopper.com/public/photon-db-planet-1.0-latest.tar.bz2

# Host port for bench.sh, bound to loopback only. nginx does not use it: it
# reaches Photon over the compose network.
PHOTON_HOST_PORT=2322

# uid:gid owning PHOTON_DATA_DIR on the host (existing `photon` user = 1000).
# The container runs as this user (`user:` in docker-compose.yml).
PHOTON_UID=1000
PHOTON_GID=1000

# Heap. Measured on the old instance: peak 1.9 GB used, 0 full GCs in 428 days,
# against a LARGER index. 4g is generous. Every GB here is a GB the kernel
# cannot use to cache the index, which is what actually determines latency.
JAVA_HEAP_MIN=2g
JAVA_HEAP_MAX=4g

# This server's token for reporting its cron jobs to the private dashboard on
# status.versatiles.org (bin/cron/run.sh): REPORT_TOKEN_GEOCODE from the .env
# there. Without it, the cron jobs run as before and report nothing.
# Optional; REPORT_URL defaults to https://status.versatiles.org/report
# REPORT_TOKEN=
# REPORT_URL=https://status.versatiles.org/report
